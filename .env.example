# Copy to .env and fill in.

# --- Database (MongoDB) ---
DATABASE_URL=mongodb://localhost:27017
DB_NAME=devsrecipe

# --- Admin ---
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Created automatically the first time anyone opens the admin sign-in, if no admin exists yet.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (forgot password) ---
# Leave SMTP_HOST empty in development: reset links are printed in the server terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Devs Recipe <no-reply@devsrecipe.com>"
